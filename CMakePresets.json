{
  "version": 6,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native Windows",
      "description": "Build with the local Windows compiler",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "web",
      "displayName": "Emscripten Web",
      "description": "Build with Emscripten",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "web",
      "configurePreset": "web"
    }
  ]
}